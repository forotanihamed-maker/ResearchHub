# ایمیل‌های مجاز برای پنل دستیار توسعه‌دهنده، جداشده با کاما.
# خالی یا تنظیم‌نشده = هیچ‌کس دسترسی ندارد.
DEV_ADMIN_EMAILS=

# ---- دستیار هوش مصنوعی (مرحله ۶) ----
# fake = رایگان و بدون شبکه (پیش‌فرض)، deepseek = فراخوانی واقعی
AI_PROVIDER=fake
# کلید DeepSeek؛ هرگز commit نشود. (نام جایگزین: AI_API_KEY)
Deep_Seek_ApiKey=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL_TRIAGE=deepseek-flash
AI_MODEL_DEEP=deepseek-v4-pro
AI_ENABLED=true
# سقف ماهانه به دلار (فقط هنگام ساخت ردیف ماه؛ بعداً با scripts/ai-budget.mjs --cap)
AI_MONTHLY_CAP_USD=5
# راز مشترک برای /api/cron/triage (بدون آن همه‌ی درخواست‌ها رد می‌شوند)
CRON_SECRET=
