# ایمیل‌های مجاز برای پنل دستیار توسعه‌دهنده، جداشده با کاما.
# خالی یا تنظیم‌نشده = هیچ‌کس دسترسی ندارد.
DEV_ADMIN_EMAILS=

# ---- دستیار هوش مصنوعی (مرحله ۶) ----
# fake = رایگان و بدون شبکه (پیش‌فرض)، deepseek = فراخوانی واقعی
AI_PROVIDER=fake
# مقدارهای مجاز: fake | deepseek | openai_compatible (دروازه‌هایی مثل AvalAI؛ نیازمند AI_BASE_URL و AI_MODEL_TRIAGE و AI_API_KEY)
# کلید DeepSeek؛ هرگز commit نشود. (نام جایگزین: AI_API_KEY)
Deep_Seek_ApiKey=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL_TRIAGE=deepseek-flash
AI_MODEL_DEEP=deepseek-v4-pro
AI_ENABLED=true
# سقف ماهانه به دلار (فقط هنگام ساخت ردیف ماه؛ بعداً با scripts/ai-budget.mjs --cap)
AI_MONTHLY_CAP_USD=5
# راز مشترک برای /api/cron/triage (بدون آن همه‌ی درخواست‌ها رد می‌شوند)
CRON_SECRET=
# فقط برای openai_compatible:
# AI_API_KEY=
# AI_TOKEN_PARAM=max_tokens            # یا max_completion_tokens برای مدل‌های جدید OpenAI
# AI_OMIT_TEMPERATURE=false            # true اگر مدل temperature را نمی‌پذیرد
# قیمت واقعی مدل (دلار به ازای هر یک میلیون توکن)؛ اگر نگذارید، نرخ محافظه‌کارانه‌ی بالا فرض می‌شود:
# AI_PRICE_INPUT_USD_PER_M=
# AI_PRICE_OUTPUT_USD_PER_M=
# سقف توکن خروجی هر فراخوانی (پیش‌فرض 700). مدل‌های reasoning (مثل gpt-5) بخشی از آن را برای استدلال پنهان مصرف می‌کنند؛ اگر پاسخ خالی/needs_human زیاد شد، 3000 بگذارید:
# AI_MAX_OUTPUT_TOKENS=700

# --- Code access for "تحلیل با کد" (read-only; token ONLY in Vercel / .env.local, never commit) ---
# GITHUB_READ_TOKEN=github_pat_...   (fine-grained, Contents: Read-only, this repo only)
# GITHUB_REPO=owner/name
# GITHUB_BRANCH=main

# --- File storage (S3-compatible: Liara, Arvan, MinIO ...). When all four are set, NEW uploads go here. ---
# Without them the old Vercel Blob (BLOB_READ_WRITE_TOKEN) is used. Existing Blob files stay readable.
# S3_ENDPOINT=https://<endpoint from your provider>
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET=...
# S3_REGION=default           (optional)
# S3_FORCE_PATH_STYLE=true    (optional; set false only if your provider requires virtual-host style)
